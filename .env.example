NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CSRF_SECRET=replace-with-another-long-random-secret-at-least-32-characters
ADMIN_SEED_PASSWORD=replace-before-running-seed-and-remove-after-use
# Development students are created ONLY if this is set (min 12 chars); they must change it on first login.
# Re-running the seed never modifies existing accounts. Leave unset to seed no students.
# SEED_STUDENT_PASSWORD=choose-a-dev-only-password
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=500
# --- Multi-instance / AWS settings (all optional; leave unset for a single local instance) ---
# Redis (ElastiCache) shares rate-limit counters and import previews between instances. Unset = in-process fallback.
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=quizora:
# REDIS_REQUIRED=false          # true: /health/ready also fails when Redis is down (default false: exams do not use Redis)
# Reverse proxies in front of the app: 0 = none (local), 1 = AWS ALB, 2 = CloudFront + ALB. Never "true". See docs/DEPLOYMENT.md.
# TRUST_PROXY_HOPS=0
# Secure cookie flag: true | false | auto (follow X-Forwarded-Proto). Default: true in production, false otherwise.
# COOKIE_SECURE=true
# /auth rate limit per client IP (defaults = the original policy)
# AUTH_RATE_LIMIT_MAX=50
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# Per-process Prisma pool (overrides connection_limit in DATABASE_URL). Suggested: API 10, worker 3. See docs/DEPLOYMENT.md.
# DB_CONNECTION_LIMIT=10
# DB_POOL_TIMEOUT_SECONDS=10

# Background worker that finalizes expired attempts (npm run worker)
WORKER_POLL_INTERVAL_MS=15000
WORKER_BATCH_SIZE=50
# Integration tests ONLY. Must be a LOCAL database whose name ends in _test (never Neon/RDS), and a LOCAL Redis.
# TEST_DATABASE_URL="postgresql://quizora:local_only_change_me@localhost:5432/quizora_test"
# TEST_REDIS_URL="redis://localhost:6379"

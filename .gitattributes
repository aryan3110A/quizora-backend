# Scripts, units and container files run on Linux: keep LF line endings on every machine (a stray CR breaks `#!/bin/bash`).
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.example text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf

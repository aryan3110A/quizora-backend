generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  FINALIZED
}

enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  TRUE_FALSE
}

enum NotificationAudience {
  ALL
  STREAM
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  studentId          String             @unique
  passwordHash       String
  fullName           String
  role               Role               @default(STUDENT)
  streamId           String?            @db.Uuid
  stream             Stream?            @relation(fields: [streamId], references: [id])
  isActive           Boolean            @default(true)
  mustChangePassword Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attempts           Attempt[]
  notificationReads  NotificationRead[]
  sessions           Session[]
  auditLogs          AuditLog[]         @relation("AuditActor")

  @@index([streamId, isActive])
}

model Stream {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  users         User[]
  quizzes       QuizStream[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
}

model Quiz {
  id                  String       @id @default(uuid()) @db.Uuid
  title               String
  description         String?
  startsAt            DateTime
  endsAt              DateTime
  durationMinutes     Int
  defaultMarks        Float        @default(1)
  status              QuizStatus   @default(DRAFT)
  publishedAt         DateTime?
  resultReleasePolicy String       @default("AFTER_CLOSE")
  questions           Question[]
  streams             QuizStream[]
  attempts            Attempt[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status, startsAt, endsAt])
}

model QuizStream {
  quizId   String @db.Uuid
  streamId String @db.Uuid
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([quizId, streamId])
  @@index([streamId, quizId])
}

model Question {
  id               String            @id @default(uuid()) @db.Uuid
  quizId           String            @db.Uuid
  quiz             Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type             QuestionType      @default(SINGLE_SELECT)
  text             String
  imageKey         String?
  topic            String?
  difficulty       String?
  marks            Float             @default(1)
  negativeMarks    Float             @default(0)
  explanation      String?
  position         Int
  options          QuestionOption[]
  correctOptionId  String?           @db.Uuid
  createdAt        DateTime          @default(now())
  attemptQuestions AttemptQuestion[]
  attemptAnswers   AttemptAnswer[]

  @@unique([quizId, position])
  @@index([quizId, topic])
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  imageKey   String?
  position   Int
  isCorrect  Boolean  @default(false)

  @@unique([questionId, position])
  @@index([questionId])
}

model Attempt {
  id          String            @id @default(uuid()) @db.Uuid
  quizId      String            @db.Uuid
  userId      String            @db.Uuid
  quiz        Quiz              @relation(fields: [quizId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  startedAt   DateTime          @default(now())
  deadlineAt  DateTime
  submittedAt DateTime?
  finalizedAt DateTime?
  status      AttemptStatus     @default(IN_PROGRESS)
  score       Float?
  totalMarks  Float?
  answers     AttemptAnswer[]
  questions   AttemptQuestion[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([quizId, userId])
  @@index([userId, status])
  @@index([status, deadlineAt])
}

model AttemptQuestion {
  id                  String   @id @default(uuid()) @db.Uuid
  attemptId           String   @db.Uuid
  questionId          String   @db.Uuid
  displayOrder        Int
  optionOrderSnapshot Json
  attempt             Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question            Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@unique([attemptId, displayOrder])
}

model AttemptAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @db.Uuid
  questionId       String   @db.Uuid
  selectedOptionId String?  @db.Uuid
  savedAt          DateTime @updatedAt
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  title        String
  body         String
  audienceType NotificationAudience @default(ALL)
  streamId     String?              @db.Uuid
  stream       Stream?              @relation(fields: [streamId], references: [id])
  publishedAt  DateTime             @default(now())
  reads        NotificationRead[]

  @@index([publishedAt])
}

model NotificationRead {
  notificationId String       @db.Uuid
  userId         String       @db.Uuid
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
